# ---------------------------------------------------------------------------
# TalentBridge — environment template
# Copy to `.env` and fill in. `.env` is gitignored; never commit real values.
#
# Keys use ASP.NET Core's Section__Key form so the same file is read by both
# `dotnet run` (Post API loads it at startup in Development) and docker-compose
# (`env_file`). Both APIs read this one file.
# ---------------------------------------------------------------------------

# --- Database mode -----------------------------------------------------------
# Local mode (default): docker compose starts a postgres:17 container.
#   USE_SUPABASE=false and COMPOSE_PROFILES=local
# Supabase mode: the local postgres service is skipped via the compose profile.
#   USE_SUPABASE=true, COMPOSE_PROFILES= (empty), and the two connection strings below.
USE_SUPABASE=false
COMPOSE_PROFILES=local

# Local Postgres container (local mode). If you change these, also set
# Database__ConnectionString below — the compose default assumes talentbridge/talentbridge.
POSTGRES_DB=talentbridge
POSTGRES_USER=talentbridge
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Runtime connection string for both APIs. Leave EMPTY in local mode:
#   `dotnet run` then uses localhost from appsettings.Development.json and
#   docker compose uses Host=postgres;… from docker-compose.yml.
#   Supabase: the POOLED string (port 6543), e.g.
#   Host=aws-0-<region>.pooler.supabase.com;Port=6543;Database=postgres;Username=postgres.<ref>;Password=<pw>;SSL Mode=Require
Database__ConnectionString=
# Supabase only: the DIRECT string (port 5432) used by the migration bundle and the seed
Database__MigrationsConnectionString=
# Post API applies pending EF Core migrations on startup (Development / `dotnet run` only;
# docker compose runs the migration bundle in the post-migrate service instead)
Database__ApplyMigrationsOnStartup=true

# Host ports published by docker compose
POST_API_PORT=5001
SEARCH_API_PORT=5002

# --- Post API (write side, :5001) ------------------------------------------
# HMAC-SHA256 signing key for access tokens. ≥ 32 characters. Generate with:
#   openssl rand -base64 48
Jwt__SigningSecret=HNG9DjkUEs4wfkhlqtwVVx90F4fQV6i5pIsZhAsMUFDEifLrWfNh2b5E7WukbNis
Jwt__Issuer=talentbridge-post-api
Jwt__Audience=talentbridge-post-web
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=14
# Projection__SearchApiBaseUrl is NOT set here on purpose: `dotnet run` uses
# http://localhost:5002 from appsettings.Development.json and docker-compose
# sets the in-network address itself.

# --- Shared by both APIs -----------------------------------------------------
# Secret the Post API sends on POST /internal/projections/job and the Search
# API verifies. ≥ 32 characters. Generate with:
#   openssl rand -base64 48
Projection__SharedSecret=u1dctSw0slpwupxeMMQabBh2Uka08mOQXqBSXKuyjBgGusPcK7v2X9qsjoszEGUo

# Outbox publisher (Post API) — defaults shown
Outbox__PollIntervalSeconds=2
Outbox__BatchSize=20
Outbox__MaxAttempts=10
Outbox__BackedUpAfterMinutes=2

# --- CORS (both APIs) --------------------------------------------------------
# `dotnet run` reads these directly; docker compose maps POST_WEB_ORIGIN / SEARCH_WEB_ORIGIN onto them.
Cors__AllowedOrigins__0=http://localhost:4200
Cors__AllowedOrigins__1=http://localhost:4201
POST_WEB_ORIGIN=http://localhost:4200
SEARCH_WEB_ORIGIN=http://localhost:4201
