# ---------------------------------------------------------------------------
# TalentBridge — environment template
# Copy to `.env` and fill in. `.env` is gitignored; never commit real values.
#
# Keys use ASP.NET Core's Section__Key form so the same file is read by both
# `dotnet run` (Post API loads it at startup in Development) and docker-compose
# (`env_file`). Both APIs read this one file.
# ---------------------------------------------------------------------------

# --- Database mode -----------------------------------------------------------
# false → docker-compose starts a local postgres:17 container (default)
# true  → use Supabase; the local postgres service is skipped
USE_SUPABASE=false

# Local Postgres container (used when USE_SUPABASE=false)
POSTGRES_DB=talentbridge
POSTGRES_USER=talentbridge
POSTGRES_PASSWORD=

# Runtime connection string for both APIs.
#   local:    Host=postgres;Port=5432;Database=talentbridge;Username=talentbridge;Password=<POSTGRES_PASSWORD>
#   supabase: the POOLED string (port 6543)
Database__ConnectionString=
# Supabase only: the DIRECT string (port 5432) used for EF Core migrations
Database__MigrationsConnectionString=
# Post API applies pending EF Core migrations on startup (Development only)
Database__ApplyMigrationsOnStartup=true

# --- Post API (write side, :5001) ------------------------------------------
# HMAC-SHA256 signing key for access tokens. ≥ 32 characters. Generate with:
#   openssl rand -base64 48
Jwt__SigningSecret=
Jwt__Issuer=talentbridge-post-api
Jwt__Audience=talentbridge-post-web
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=14
# Where the outbox publisher pushes projections
Projection__SearchApiBaseUrl=http://search-api:8080

# --- Shared by both APIs -----------------------------------------------------
# Secret the Post API sends on POST /internal/projections/job. Generate with:
#   openssl rand -base64 48
Projection__SharedSecret=

# --- CORS (both APIs) --------------------------------------------------------
Cors__AllowedOrigins__0=http://localhost:4200
Cors__AllowedOrigins__1=http://localhost:4201
