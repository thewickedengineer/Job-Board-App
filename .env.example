# ---------------------------------------------------------------------------
# TalentBridge — environment template
# Copy to `.env` and fill in. `.env` is gitignored; never commit real values.
# ---------------------------------------------------------------------------

# --- Database mode -----------------------------------------------------------
# false → docker-compose starts a local postgres:17 container (default)
# true  → use Supabase; the local postgres service is skipped
USE_SUPABASE=false

# Local Postgres (used when USE_SUPABASE=false)
POSTGRES_DB=talentbridge
POSTGRES_USER=talentbridge
POSTGRES_PASSWORD=

# Supabase (used when USE_SUPABASE=true)
# Pooled (port 6543) — runtime connections from both APIs
SUPABASE_POOLED_CONNECTION_STRING=
# Direct (port 5432) — EF Core migrations only
SUPABASE_DIRECT_CONNECTION_STRING=

# --- Post API (write side, :5001) ------------------------------------------
# HMAC-SHA256 signing key for access tokens. Minimum 32 bytes, base64 or raw.
JWT_SIGNING_SECRET=
JWT_ISSUER=talentbridge-post-api
JWT_AUDIENCE=talentbridge-post-web
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=14
# Apply EF Core migrations on startup (Development only)
POST_APPLY_MIGRATIONS_ON_STARTUP=true
# Where the outbox publisher pushes projections
SEARCH_API_BASE_URL=http://search-api:8080

# --- Search API (read side, :5002) -----------------------------------------
# Shared secret the Post API sends on POST /internal/projections/job
PROJECTION_SHARED_SECRET=

# --- CORS (both APIs) --------------------------------------------------------
POST_WEB_ORIGIN=http://localhost:4200
SEARCH_WEB_ORIGIN=http://localhost:4201
