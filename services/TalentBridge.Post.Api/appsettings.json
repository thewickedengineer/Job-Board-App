{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "talentbridge-post-api",
    "Audience": "talentbridge-post-web",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "AuthRateLimit": {
    "LoginPermitLimit": 5,
    "LoginWindowMinutes": 5,
    "SignupPermitLimit": 5,
    "SignupWindowMinutes": 10
  }
}
